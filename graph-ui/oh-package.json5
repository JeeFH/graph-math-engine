{
  "name": "graph-ui",
  "version": "0.1.0",
  "description": "Reference UI components for the graph plotting engine on HarmonyOS: GraphCanvas (interactive canvas with gestures, settings, export), GraphDisplayArea (function slot list) and AnalysisDock. Hosts can inject share/storage adapters.",
  "main": "Index.ets",
  "author": "graph-math-engine contributors",
  "license": "MIT",
  "keywords": [
    "harmonyos",
    "arkts",
    "graph",
    "canvas",
    "plot-ui"
  ],
  "packageType": "har",
  "dependencies": {
    "graph": "file:../graph",
    "exprrender": "file:../exprrender"
  }
}
