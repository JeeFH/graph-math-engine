  "author": "graph-math-engine contributors",
  "license": "MIT",
  "keywords": [
    "harmonyos",
    "arkts",
    "graph",
    "plot",
    "function-analysis",
    "implicit-curve"
  ],
  "packageType": "har",
  "dependencies": {
    "mathkit": "file:../mathkit",
    "exprrender": "file:../exprrender"
  }
}
