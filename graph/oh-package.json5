{
  "name": "graph",
  "version": "0.1.0",
  "description": "2D graph plotting engine for HarmonyOS: expression classification, function evaluation, adaptive sampling, explicit/implicit/inequality/bivariate renderers and global function analysis. Pure logic, zero UI dependency.",
