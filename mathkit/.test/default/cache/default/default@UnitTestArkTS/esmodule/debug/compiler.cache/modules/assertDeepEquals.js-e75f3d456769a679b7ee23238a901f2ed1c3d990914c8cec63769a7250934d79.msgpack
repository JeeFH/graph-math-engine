        }
    }
    if (DeepTypeUtils.isFunction(a) && DeepTypeUtils.isFunction(b)) {
        // ä¿©ä¸ªå‡½æ•°å¯¹è±¡
        const aCtor = a.constructor,
            bCtor = b.constructor;
