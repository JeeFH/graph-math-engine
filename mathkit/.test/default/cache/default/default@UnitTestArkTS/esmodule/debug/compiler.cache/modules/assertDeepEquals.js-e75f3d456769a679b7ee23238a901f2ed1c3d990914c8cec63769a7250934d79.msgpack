        }
    }

    if (DeepTypeUtils.isPromise(a) && DeepTypeUtils.isPromise(b)) {
        const aIsPromise = DeepTypeUtils.isPromise(a);
        const bIsPromise = DeepTypeUtils.isPromise(b);
        // ä¿©ä¸ªPromiseå¯¹è±¡
        if (aIsPromise && bIsPromise) {
            equalNodeOrPromiseOrFunction = a === b;
